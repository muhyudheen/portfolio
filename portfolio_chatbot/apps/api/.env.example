# Copy to `.env` and fill in. The API reads these at startup
# (run: uvicorn app.main:app --env-file .env).
# Without LLM_API_KEY the /chat endpoint replies with a friendly fallback.

# --- LLM: defaults to Google Gemini (OpenAI-compatible endpoint) ---
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash

# Other providers work too — just change base URL + model:
#   OpenAI:              https://api.openai.com/v1            (gpt-4o-mini)
#   OpenRouter:          https://openrouter.ai/api/v1
#   IITM / aipipe proxy: https://aipipe.org/openai/v1

# --- CORS: your deployed frontend origin(s), comma-separated ---
# e.g. https://your-portfolio.vercel.app
FRONTEND_ORIGIN=
