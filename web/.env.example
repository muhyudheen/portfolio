# Copy to `.env` for local dev, or set in Vercel → Project → Environment Variables.
# Base URL of the chat API backend. Leave unset to default to http://localhost:8000.
# In production, point this at your deployed FastAPI backend, e.g.:
# VITE_API_URL=https://your-portfolio-api.onrender.com
VITE_API_URL=http://localhost:8000
